{% extends basePath %}

{% block others_js %}
  {{ encore_entry_script_tags('js/check_format/mapping') }}
{% endblock %}

{% block others_stylesheets %}
  {{ encore_entry_link_tags('css/imanaging_bootstrap_min') }}
{% endblock %}

{% block body %}
  {% include '@ImanagingCheckFormat/Mapping/partials/styles.html.twig' %}
<style>
  .delete-file{
    cursor: pointer;
    color: #007bff;
  }

  .delete-file:hover{
    color: #0f74a8;
  }

  .mapping_data_value {
    cursor: pointer;
    background-color: darkorange;
    color: white;
  }

  .mapping_data_value.mapping_data_value_ok {
    background-color: #1e7e34;
  }

  .mapping_data_value:hover {
    background-color: blue;
  }

  /* PREVENT BOOTSTRAP SCROLLBAR REMOVING */
  .modal-open {
    overflow: scroll;
  }
</style>

<div class="container container-full-width check-format-page check-format-main">
  <header class="check-format-heading">
    <p class="check-format-heading__eyebrow">Import de données</p>
    <h1>{{ mapping_configuration_type.libelle }}</h1>
    <p>Configurez les correspondances avant de contrôler et d’intégrer votre fichier.</p>
  </header>
  <div class="card">
    <h5 class="card-header">
      Fichiers en attente d'intégration
    </h5>
    <div class="card-body">
      <p class="check-format-file-count">{{ fichiers_en_attente|length }} fichier{{ fichiers_en_attente|length > 1 ? 's' : '' }} en attente</p>
      {% if fichiers_en_attente|length > 0 %}
        <ul class="check-format-file-list">
          {% for fichier in fichiers_en_attente %}
            <li>
              <span class="check-format-file-name"><i class="fa fa-file fa-fw" aria-hidden="true"></i>{{ fichier.basename }}</span>
              <button type="button" class="delete-file check-format-file-remove" data-file-basename="{{ fichier.basename }}" data-url="{{ path('check_format_mapping_files_delete', {code: mapping_configuration_type.code}) }}" aria-label="Supprimer le fichier {{ fichier.basename }}"><i class="fa fa-trash fa-fw" aria-hidden="true"></i>Supprimer</button>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="check-format-empty">Aucun fichier en attente d’intégration.</p>
      {% endif %}
    </div>
  </div>

  <div class="card mt-4">
    <h5 class="card-header">
      Sélection du mapping
    </h5>
    <div class="card-body">
      <div id="mapping_configuration_loader">
        <i class="fa fa-spin fa-spinner fa-lg"></i>
        <span>Chargement des configurations en cours ...</span>
      </div>
      <div id="mapping_configuration" data-url="{{ path('check_format_mapping_select_configurations', {codeMappingConfiguration: mapping_configuration_type.code}) }}"></div>
    </div>
  </div>

  <div class="card mt-4 mb-5">
    <h5 class="card-header">
      Configuration
    </h5>
    <div class="card-body">
      <div id="mappingConfigurationLoad" class="d-none">
        <span>Chargement des configurations en cours ...</span>
      </div>

      <div id="affichageMappingGlobal">
        <div id="divObligatoiresAMapper" data-url="{{ path('check_format_mapping_get_champs_obligatoires_a_mapper') }}">
        </div>
        <div class="text-center mb-4">
          <button id="btnGererChampsPossibles" class="btn btn-primary btn-raised" data-url="{{ path('check_format_mapping_champs_possibles_gerer', {code: mapping_configuration_type.code}) }}"><i class="fa fa-pencil fa-fw"></i>Gérer les champs possibles</button>
        </div>

        <div class="check-format-modes mb-4" role="group" aria-label="Modes de configuration">
            <button type="button" id="btnModeRecapitulaif" aria-pressed="true" class="btn btn-raised btn-success">Mode récapitulatif</button>
            <button type="button" id="btnModeDecoupageChamps" aria-pressed="false" class="btn btn-outline-secondary">Mode découpage champs</button>
            <button type="button" id="btnModeMapping" aria-pressed="false" class="btn btn-outline-secondary">Mode mapping</button>
            <button type="button" id="btnModeAvance" aria-pressed="false" class="btn btn-outline-secondary">Mode avancé</button>
        </div>

        <div id="divRecapitulatif">
          <h3 class="check-format-section-title">Mode récapitulatif</h3>
          <div class="check-format-table-scroll"><table class="table table-bordered table-striped text-center">
            <thead>
            <tr>
              <th>Type</th>
              <th>Valeur</th>
              <th>Code mapping</th>
              <th>Traductions</th>
              <th>Transformations</th>
            </tr>
            </thead>
            <tbody id="tableRecapitulatif" data-url="{{ path('check_format_mapping_show_recap_configuration') }}">
              <tr><th colspan="4">Chargement en cours ...</th></tr>
            </tbody>
          </table></div>
        </div>

        <div id="divModeDecoupageChamps" class="d-none">
          <h3 class="check-format-section-title">Mode découpage champs</h3>
          <div class="check-format-table-scroll"><table class="table table-bordered table-striped text-center">
            <thead>
            <tr>
              <th>Type</th>
              <th>Libelle</th>
              <th>Offset</th>
              <th>Longueur</th>
            </tr>
            </thead>
            <tbody id="tableModeDecoupageChamp" data-url="{{ path('check_format_mapping_show_decoupage_champs_configuration') }}">
              <tr><th colspan="5">Chargement en cours ...</th></tr>
            </tbody>
          </table></div>
        </div>

        <div id="divMappingMode" class="d-none">
          <h3 class="check-format-section-title">Mode mapping</h3>
          <p class="check-format-mapping-help">Cliquez sur un champ associé pour modifier sa correspondance.</p>
          <div id="mapping-duplicate-header-warning" class="alert alert-warning d-none" role="status">Des en-têtes sont identiques : utilisez le numéro de colonne pour les distinguer.</div>
          <div class="check-format-table-scroll">
            <table class="table table-bordered check-format-mapping-table">
              <thead>
              <tr id="mapping-source-headers">
                {% for donnee in ligne_entete %}
                  <th data-index="{{ loop.index }}">Colonne {{ loop.index }} — {{ donnee|default('(sans en-tête)', true) }}</th>
                {% endfor %}
              </tr>
              <tr id="tr_mapping" data-url="{{ path('check_format_mapping_get_configuration_values') }}" data-url-select-champs="{{ path('check_format_mapping_select_champs', {code: mapping_configuration_type.code}) }}">
                {% for donnee in ligne_entete %}
                  <th data-index="{{ loop.index - 1 }}" data-lib-colonne="{{ donnee|e('html_attr') }}" class="mapping_data_value d" ></th>
                {% endfor %}
              </tr>
              </thead>
              <tbody>
              {% for ligne in lignes %}
                <tr>
                  {% for donnee in ligne %}
                    <td>{{ donnee }}</td>
                  {% endfor %}
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div id="divModeAvance" data-url="{{ path('check_format_mapping_get_configuration_values_avances') }}" class="d-none">
          <h3><i class="fa fa-spin fa-spinner"></i><span> Configuration en cours de chargement ...</span></h3>
        </div>

        <div class="text-center mt-4">
          <a id="btnValidMappingAndRunIntegration" href="{{ path('check_format_mapping_controle_page', {code: mapping_configuration_type.code}) }}"
             class="btn btn-success btn-raised disabled">
            Valider la configuration
          </a>
        </div>
      </div>
    </div>
  </div>

  <div id="loader-transitions-translations" class="d-none mt-4">
    <div class="text-center">
      <h4>
        <i class="fa fa-spinner fa-spin fa-fw"></i>Chargement des données de traduction ou transformation en cours ..
      </h4>
    </div>
  </div>

  <div id="gerer-champs-possibles-card" class="mt-4 d-none">
  </div>

  <div id="translations-card" class="mt-4 d-none" data-url="{{ path('check_format_mapping_update_translations') }}">
  </div>

  <div id="transformations-card" class="mt-4 d-none" data-url="{{ path('check_format_mapping_update_transformations') }}">
  </div>
</div>

<div id="divModalSelectChamps">
</div>
{% endblock %}