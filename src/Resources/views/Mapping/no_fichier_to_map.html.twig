{% extends basePath %}

{% block others_js %}
  {{ encore_entry_script_tags('js/check_format/no_fichier_to_map') }}
{% endblock %}

{% block body %}
  {% include '@ImanagingCheckFormat/Mapping/partials/styles.html.twig' %}
  <div class="container container-full-width check-format-page check-format-main check-format-upload">
    <header class="check-format-heading">
      <p class="check-format-heading__eyebrow">Import de données</p>
      <h1>{{ mapping_configuration_type.libelle }}</h1>
      <p>Sélectionnez un fichier pour préparer son mapping et lancer son contrôle.</p>
    </header>

    <button type="button" class="btn check-format-upload__back" onclick="history.back()"><i class="fa fa-arrow-left fa-fw" aria-hidden="true"></i>Retour</button>

    <div class="check-format-upload__layout">
      <section class="card">
        <h2 class="card-header">Importer un fichier</h2>
        <div class="card-body">
          <p class="check-format-upload__intro">Choisissez le fichier à importer pour configurer les correspondances avec vos données.</p>
          <div class="check-format-upload__picker">
            <span class="check-format-upload__icon" aria-hidden="true"><i class="fa fa-file"></i></span>
            <div class="check-format-upload__field">
              <label for="fichier">Fichier à importer</label>
              <p id="check-format-file-help">Formats acceptés : CSV, TXT, XLS, XLSX et XML.</p>
              <input type="file" class="form-control" id="fichier" accept=".csv,.txt,.xls,.xlsx,.xml,text/csv,text/xml,application/xml" aria-describedby="check-format-file-help">
            </div>
          </div>

          <form id="custom-form">
            {% block custom_form %}
            {% endblock %}
          </form>

          <div class="check-format-upload__actions">
            <button type="button" id="btn-upload-file" class="btn check-format-upload__primary" data-url="{{ path('check_format_mapping_files_upload', {code: mapping_configuration_type.code}) }}"><i class="fa fa-upload fa-fw" aria-hidden="true"></i>Envoyer le fichier</button>
            <div id="loader-upload" class="d-none check-format-upload__loading" role="status"><i class="fa fa-spin fa-spinner fa-fw" aria-hidden="true"></i>Envoi du fichier en cours…</div>
          </div>
          <div id="error-message" class="alert alert-danger d-none" role="alert"></div>
        </div>
      </section>

      <section class="card check-format-upload__requirements">
        <h2 class="card-header">Données obligatoires</h2>
        <div class="card-body">
          <p>Ces champs devront être associés lors de l’étape de mapping.</p>
          {% if champs_obligatoires is not empty %}
            <ul class="check-format-upload__fields">
              {% for champ in champs_obligatoires %}
                <li><i class="fa fa-check-circle" aria-hidden="true"></i><span>{{ champ.libelle }}</span></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="check-format-upload__empty">Aucun champ obligatoire configuré.</p>
          {% endif %}
        </div>
      </section>
    </div>
  </div>
{% endblock %}
