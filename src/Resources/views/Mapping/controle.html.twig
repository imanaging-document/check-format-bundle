{% extends basePath %}

{% block others_js %}
  {{ encore_entry_script_tags('js/check_format/controle') }}
{% endblock %}

{% block others_stylesheets %}
  {{ encore_entry_link_tags('css/imanaging_bootstrap_min') }}
{% endblock %}

{% block body %}
  {% include '@ImanagingCheckFormat/Mapping/partials/styles.html.twig' %}
  <div class="container container-full-width check-format-page check-format-main check-format-control">
    <header class="check-format-heading">
      <p class="check-format-heading__eyebrow">Import de données</p>
      <h1>{{ mapping_configuration_type.libelle }}</h1>
      <p>Contrôlez votre fichier avant de lancer son intégration.</p>
    </header>

    <a href="{{ path('check_format_mapping_page', {code: mapping_configuration_type.code}) }}" class="btn check-format-control__back">
      <i class="fa fa-arrow-left fa-fw" aria-hidden="true"></i>Revenir au mapping
    </a>

    <section class="card">
      <h2 class="card-header">Contrôle du fichier</h2>
      <div class="card-body">
        {% if fichiers_clients|length > 0 %}
          <h3 class="check-format-control__section-title">Fichiers en attente d’intégration</h3>
          <div class="check-format-control__files">
            {% for fichier in fichiers_clients %}
              {% if fichier is not null %}
                <div class="check-format-control__file">
                  <div class="check-format-control__file-heading">
                    <i class="fa fa-file fa-fw" aria-hidden="true"></i>
                    <div>
                      <div class="check-format-control__filename">{{ fichier.filename }}</div>
                      <div class="check-format-control__original">Nom initial : {{ fichier.initialFilename }}</div>
                    </div>
                  </div>
                  {% if advanced_values_saisie_manuelle|length > 0 %}
                    <form class="check-format-control__manual" action="{{ path('check_format_mapping_configuration_file_save_saisies_manuelles', {'id' : fichier.id}) }}" method="post">
                      {% for value in advanced_values_saisie_manuelle %}
                        <div class="form-group">
                          <label for="{{ value.id }}">Donnée à saisir : {{ value.mappingConfigurationValue.mappingCode }}</label>
                          <input type="text" id="{{ value.id }}" name="{{ value.id }}" value="{{ fichier.getValueSaisieManuelle(value.id) }}" class="form-control">
                        </div>
                      {% endfor %}
                      <button type="submit" class="btn check-format-control__secondary">Enregistrer</button>
                    </form>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <div id="spinner_integration" class="d-none check-format-control__progress" role="status">
            <i class="fa fa-spinner fa-spin fa-fw" aria-hidden="true"></i> Contrôle en cours…
          </div>
          <div id="div_controle" class="check-format-control__step">
            <h3 class="check-format-control__section-title">Vérifier la structure</h3>
            <p>Lancez le contrôle pour vérifier que le fichier correspond à la configuration de mapping.</p>
            <button id="btn_controle_fichier" type="button" class="btn check-format-control__primary" data-url="{{ path('check_format_mapping_controler_fichier', {code: mapping_configuration_type.code}) }}">
              <i class="fa fa-check-circle fa-fw" aria-hidden="true"></i>Contrôler le fichier
            </button>
          </div>
          <div id="div_resultat_import" class="check-format-control__results" aria-live="polite"></div>
        {% else %}
          <p class="check-format-empty"><i class="fa fa-info-circle fa-fw" aria-hidden="true"></i>Aucun fichier n'est en attente d'intégration. Retournez au mapping pour soumettre un fichier.</p>
        {% endif %}
      </div>
    </section>
  </div>
{% endblock %}
