<h5>Détail de la valeur <b>{{ value.mappingCode }}</b>:</h5>

{% if values_avances|length > 0 %}
<table class="table table-bordered table-striped text-center">
  <thead>
    <tr>
      <th>Type</th>
      <th>Valeur</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  {% for valeur_avance in values_avances %}
    <tr>
      <td>{{ valeur_avance.mappingConfigurationValueAvanceType.libelle }}</td>
      <td>
        {{ valeur_avance.value }}
        {% if valeur_avance.mappingConfigurationValueAvanceType.code == 'value_file' %}
          <div class="part-transformations mt-2 text-left" data-id="{{ valeur_avance.id }}"
               data-token="{{ csrf_token('mapping_file_padding_' ~ valeur_avance.id) }}">
            <strong>Transformations de cette colonne</strong>
            <small class="d-block text-muted">Appliquées dans l’ordre affiché, avant la concaténation.</small>
            {% for transformation in transformations_by_part[valeur_avance.id]|default([]) %}
              {% set options = transformation.transformationOptions|default({}) %}
              <div class="d-flex align-items-center justify-content-between mt-1">
                <span>
                  {{ transformations[transformation.transformation]|default(transformation.transformation) }}
                  {% if transformation.transformation == 'replace' %}
                    — « {{ options.search|default('') }} » → « {{ options.replace|default('') }} »
                  {% elseif transformation.transformation == 'decimal_to_integer' %}
                    — séparateur décimal : {{ options.decimal_separator|default(',') }}, milliers : {{ options.thousands_separator|default('aucun', true) }}, décimales : {{ options.decimal_places|default(2) }}
                  {% elseif transformation.transformation not in ['invert_sign', 'remove_character_zero_start'] %}
                    — {{ transformation.nbCaract }} caractères
                  {% endif %}
                </span>
                <button type="button" class="btn btn-outline-danger btn-sm remove-part-transformation ml-2"
                        data-transformation-id="{{ transformation.id }}" aria-label="Supprimer la transformation">Supprimer</button>
              </div>
            {% else %}
              <small class="d-block text-muted">Aucune transformation.</small>
            {% endfor %}
            <details class="mt-2">
              <summary>Ajouter une transformation</summary>
              <div class="form-group mt-2">
                <label for="part-transform-{{ valeur_avance.id }}">Transformation</label>
                <select id="part-transform-{{ valeur_avance.id }}" class="form-control part-transform-code">
                  {% for code, label in transformations %}<option value="{{ code }}">{{ label }}</option>{% endfor %}
                </select>
              </div>
              <div class="form-group part-transform-length">
                <label for="part-length-{{ valeur_avance.id }}">Nombre de caractères</label>
                <input id="part-length-{{ valeur_avance.id }}" type="number" min="1" max="255" step="1" class="form-control part-length">
              </div>
              <div class="part-transform-replace d-none">
                <label for="part-search-{{ valeur_avance.id }}">Valeur à rechercher</label>
                <input id="part-search-{{ valeur_avance.id }}" type="text" class="form-control part-search">
                <label for="part-replace-{{ valeur_avance.id }}">Remplacer par</label>
                <input id="part-replace-{{ valeur_avance.id }}" type="text" class="form-control part-replace">
              </div>
              <div class="part-transform-decimal d-none">
                <label for="part-decimal-{{ valeur_avance.id }}">Séparateur décimal</label>
                <select id="part-decimal-{{ valeur_avance.id }}" class="form-control part-decimal"><option value=",">Virgule</option><option value=".">Point</option></select>
                <label for="part-thousands-{{ valeur_avance.id }}">Séparateur de milliers</label>
                <select id="part-thousands-{{ valeur_avance.id }}" class="form-control part-thousands"><option value="">Aucun</option><option value="." selected>Point</option><option value=",">Virgule</option><option value=" ">Espace</option></select>
                <label for="part-places-{{ valeur_avance.id }}">Nombre de décimales</label>
                <input id="part-places-{{ valeur_avance.id }}" type="number" min="0" step="1" value="2" class="form-control part-places">
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm add-part-transformation mt-2">Ajouter</button>
            </details>
            <span class="part-transform-status d-block mt-1" role="status"></span>
          </div>
        {% endif %}
      </td>
      <td>
        <i class="fa fa-times text-danger pointer delete-valeur-avancee-detail"
           data-toggle="tooltip" data-placement="top" title="Supprimer la valeur" data-valeur-avancee-id="{{ valeur_avance.id }}"></i>
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% else %}
  <span class="text-warning">Aucune valeur de paramètrée pour le moment.</span>
{% endif %}
<div class="row">
  <div class="col-sm-6 offset-3">
    <button id="btnAddValeur" class="btn btn-outline-info" data-toggle="modal" data-target="#addValeurAvanceDetailModal">Ajouter une valeur</button>
  </div>
</div>

<!-- Modal -->
<div class="modal fade check-format-modal" id="addValeurAvanceDetailModal" tabindex="-1" role="dialog" aria-labelledby="addValeurAvanceDetailModal" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Ajouter une valeur avancée</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="type-valeur-avancee">Type de données</label>
          <select class="form-control" id="type-valeur-avancee">
            {% for type in types_values %}
              <option value="{{ type.code }}">{{ type.libelle }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="form-group" id="modalValueText">
          <label for="value-valeur-avancee">Valeur</label>
          <input type="text" class="form-control" id="value-valeur-avancee" placeholder="Entrez la valeur souhaitée">
        </div>

        <div class="form-group d-none" id="modalValueDelimiter">
          <label for="delimiter-valeur-avancee">Délimiteur</label>
          <input type="text" class="form-control" id="delimiter-valeur-avancee" placeholder="Entrez le délimiteur souhaitée">
        </div>

        <div class="form-group d-none" id="modalSelectEnteteFile" >
          <label for="select_entete">Valeur - entête fichier</label>
          <select class="form-control" id="select_entete" name="select_entete">
            {% for indexFile, entete in ligne_entete %}
              <option value="{{ indexFile }}" data-header="{{ entete|e('html_attr') }}">Colonne {{ loop.index }} — {{ entete|default('(sans en-tête)', true) }}</option>
            {% endfor %}
          </select>
        </div>

        <div id="modalCustomDate" class="d-none">
          <div class="form-group">
            <label for="date_custom_format">Format de la date (utilisation des <a href="https://www.php.net/manual/fr/datetime.format.php">format date time PHP</a>)</label>
            <input type="text" id="date_custom_format" name="date_custom_format" class="form-control">
          </div>

          <div class="form-group">
            <label for="date_custom_modify">Modification de la date (utilisation du <a href="https://www.php.net/manual/fr/datetime.modify.php">modify date time php</a>)</label>
            <input type="text" id="date_custom_modify" name="date_custom_modify" class="form-control">
          </div>
        </div>

        <div id="modalCustomMultiEntete" class="d-none">
          <span >Colonnes <i class="fa fa-plus-circle text-success" id="btn-add-ligne-array"></i></span>
          <table class="table table-bordered table-striped text-center" id="tableMultiColonne">
            <thead>
              <tr>
                <th>Code</th>
                <th>Colonne</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <input type="text" class="form-control" id="code_0" name="code_0">
                </td>
                <td>
                  <select class="form-control" id="select_entete_0" name="select_entete_0">
                    {% for indexFile, entete in ligne_entete %}
                      <option value="{{ indexFile }}" data-header="{{ entete|e('html_attr') }}">Colonne {{ loop.index }} — {{ entete|default('(sans en-tête)', true) }}</option>
                    {% endfor %}
                  </select>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="text-center">
          <button id="btnValidAjoutValueAvance" class="btn btn-primary">Ajouter</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function updatePartTransformationFields(container) {
    const code = container.find('.part-transform-code').val();
    container.find('.part-transform-length').toggleClass('d-none', ['replace', 'decimal_to_integer', 'invert_sign', 'remove_character_zero_start'].includes(code));
    container.find('.part-transform-replace').toggleClass('d-none', code !== 'replace');
    container.find('.part-transform-decimal').toggleClass('d-none', code !== 'decimal_to_integer');
  }
  $('.part-transformations').each(function() { updatePartTransformationFields($(this)); });
  $('.part-transform-code').change(function() { updatePartTransformationFields($(this).closest('.part-transformations')); });

  $('.add-part-transformation, .remove-part-transformation').click(function() {
    const button = $(this);
    const container = button.closest('.part-transformations');
    const status = container.find('.part-transform-status');
    const code = container.find('.part-transform-code').val();
    const removing = button.hasClass('remove-part-transformation');
    const data = {id: container.data('id'), _token: container.data('token'), transformation: code,
      nb_caract: container.find('.part-length').val(), transformation_id: button.data('transformation-id')};
    if (code === 'replace') {
      data.transformation_options = {search: container.find('.part-search').val(), replace: container.find('.part-replace').val()};
    } else if (code === 'decimal_to_integer') {
      data.transformation_options = {decimal_separator: container.find('.part-decimal').val(),
        thousands_separator: container.find('.part-thousands').val(), decimal_places: container.find('.part-places').val()};
    }
    button.prop('disabled', true);
    status.removeClass('text-danger').text('Enregistrement…');
    $.ajax({
      url: removing ? "{{ path('check_format_mapping_advanced_part_transformation_remove') }}" : "{{ path('check_format_mapping_advanced_part_transformation_add') }}",
      type: 'POST', data: data,
      success: function() {
        $('.lookingForDetail[data-id="{{ value.id }}"]').trigger('click');
      },
      error: function(response) { status.addClass('text-danger').text(response.responseJSON?.error_message || 'Enregistrement impossible.'); },
      complete: function() { button.prop('disabled', false); }
    });
  });

  var nbColonnes = 0;
  $(function () {
    $('[data-toggle="tooltip"]').tooltip()
  });

  $('#type-valeur-avancee').change(function() {
    let value = $(this).val();
    if (value === "value_file") {
      $('#modalValueText').addClass('d-none');
      $('#modalSelectEnteteFile').removeClass('d-none');
      $('#modalCustomDate').addClass('d-none');
      $('#modalValueDelimiter').addClass('d-none');
      $('#modalCustomMultiEntete').addClass('d-none');
    } else if (value === "date_custom") {
      $('#modalValueText').addClass('d-none');
      $('#modalSelectEnteteFile').addClass('d-none');
      $('#modalCustomDate').removeClass('d-none');
      $('#modalValueDelimiter').addClass('d-none');
      $('#modalCustomMultiEntete').addClass('d-none');
    } else if (value == "multi_column_array") {
      $('#modalValueText').addClass('d-none');
      $('#modalSelectEnteteFile').addClass('d-none');
      $('#modalCustomDate').addClass('d-none');
      $('#modalValueDelimiter').removeClass('d-none');
      $('#modalCustomMultiEntete').removeClass('d-none');
    } else {
      $('#modalValueText').addClass('d-none');
      $('#modalSelectEnteteFile').addClass('d-none');
      $('#modalCustomDate').addClass('d-none');
      $('#modalValueDelimiter').addClass('d-none');
      $('#modalCustomMultiEntete').addClass('d-none');
    }
  });

  $('#btnValidAjoutValueAvance').click(function(){
    console.log('yooyooy');
    let type = $('#type-valeur-avancee').val();
    if (type !== undefined){
      let value = $('#value-valeur-avancee').val();
      let file_index = $('#select_entete').val();
      let file_entete = $('#select_entete option:selected').attr('data-header');
      let date_custom_format = $('#date_custom_format').val();
      let date_custom_modify = $('#date_custom_modify').val();
      let delimiter = $('#delimiter-valeur-avancee').val();
      let multiColumnArray = [];
      for (let i = 0; i <= nbColonnes; i++) {
        multiColumnArray.push({'code' : $('#code_'+i).val(), 'value' : $('#select_entete_'+i).val()});
      }
      let data = {'value': value, 'type': type, 'file_index': file_index, 'file_entete': file_entete,
        'date_custom_format' : date_custom_format, 'date_custom_modify' : date_custom_modify, 'delimiter': delimiter, 'multi_column_array' : multiColumnArray};

      $('#divConfigurationAvances').html('<i class="fa fa-spin fa-spinner fa-2x fa-fw"></i><span>Enregistrement en cours ...</span>');
      $.ajax({
        url: "{{ path('check_format_mapping_configuration_values_avances_detail_add', {'id': value.id}) }}",
        type: 'POST',
        data: data,
        success: function (data){
          $('.modal-backdrop').remove();
          $('#divConfigurationAvances').html(data);
          let id = '{{ value.id }}';
          let td = $('.nb-valeur-avancee[data-id="' + id + '"]');
          let currentNumber = parseInt(td.html());
          td.html(currentNumber + 1);
          $('.lookingForDetail[data-id="' + id + '"]').trigger('click');
        },
        error: function (data){
          $('.modal-backdrop').remove();
          if (data.responseJSON !== undefined){
            $('#divConfigurationAvances').html('<i class="fa fa-warning fa-2x text-danger fa-fw"></i>'+data.responseJSON.error_message);
          } else {
            $('#divConfigurationAvances').html('<i class="fa fa-warning fa-2x text-danger fa-fw"></i>Une erreur inconnue est survenue.');
          }
        }
      });
    } else {
      $('.modal-backdrop').remove();
      alert('Veuillez sélectionner un type.');
    }
  });

  $(".delete-valeur-avancee-detail").click(function(){
    let valeurAvanceeId = $(this).data('valeur-avancee-id');
    let data = {valeur_avancee_id: valeurAvanceeId};
    $('#divConfigurationAvances').html('<i class="fa fa-spin fa-spinner fa-2x"></i><span> Enregistrement en cours ...</span>');
    $.ajax({
      url: "{{ path('check_format_mapping_configuration_values_avances_detail_remove') }}",
      type: 'POST',
      data: data,
      success: function (data) {
        $('#divConfigurationAvances').html(data);
        let id = '{{ value.id }}';
        let td = $('.nb-valeur-avancee[data-id="' + id + '"]');
        let currentNumber = parseInt(td.html());
        td.html(currentNumber - 1);
        $('.lookingForDetail[data-id="' + id + '"]').trigger('click');
      },
      error: function () {
        $('#divConfigurationAvances').html('<i class="fa fa-warning fa-2x text-danger"></i><span> Le chargement du détail a échoué.</span>');
      }
    });
  });

  $('#btn-add-ligne-array').click(function() {
    nbColonnes ++;
    const row = $('<tr>');
    $('<td>').append($('<input>', {type: 'text', 'class': 'form-control', id: 'code_' + nbColonnes, name: 'code_' + nbColonnes})).appendTo(row);
    const select = $('<select>', {'class': 'form-control', id: 'select_entete_' + nbColonnes, name: 'select_entete_' + nbColonnes});
    select.append($('#select_entete option').clone());
    $('<td>').append(select).appendTo(row);
    $('#tableMultiColonne tbody').append(row);
  });


</script>
