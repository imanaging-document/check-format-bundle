<div class="text-right">
  <button id="btn-close-transformations" class="btn btn-raised btn-danger"><i class="fa fa-times fa-fw"></i>Fermer la gestion des transformations</button>
</div>

<div class="card">
  <h5 class="card-header text-info">Gestion des transformations pour le champ : {{ mapping_value.mappingCode }}</h5>
  <div class="card-body">
    <table class="table table-bordered table-striped text-center">
      <thead>
      <tr>
        <th>Transformation</th>
        <th>Paramètres</th>
        <th>Action</th>
      </tr>
      </thead>
      <tbody id="tbody-transformations">
      {% for transformation in mapping_value.mappingConfigurationValueTransformations %}
        <tr>
          <td>{{ transformations[transformation.transformation]|default(transformation.transformation) }}</td>
          <td>
            {% if transformation.transformation == 'decimal_to_integer' %}
              {% set options = transformation.transformationOptions|default({}) %}
              Décimal : {{ options.decimal_separator|default(',') }} ;
              milliers : {{ options.thousands_separator is defined ? (options.thousands_separator == '' ? 'aucun' : (options.thousands_separator == ' ' ? 'espace' : options.thousands_separator)) : '.' }} ;
              décimales : {{ options.decimal_places is defined ? options.decimal_places : 2 }}
            {% else %}
              {{ transformation.nbCaract }}
            {% endif %}
          </td>
          <td>
            <i class="fa fa-trash text-warning remove-transformation pointer" data-transformation-id="{{ transformation.id }}"></i>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <hr>
    <!-- Button trigger modal -->
    <div class="text-center">
      <button type="button" class="btn btn-outline-primary" data-toggle="modal" data-target="#addTransformationModal">
        Ajouter une transformation
      </button>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="addTransformationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Ajouter une transformation</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="transformation">Type de transformation</label>
          <select class="form-control" name="transformation" id="transformation">
            {% for transformation_key, transformation_libelle in transformations %}
              <option value="{{ transformation_key }}">{{ transformation_libelle }}</option>
            {% endfor %}
          </select>
        </div>
        <div id="transformation-nb-caract-group" class="form-group">
          <label for="nb_caract">Nb caractères</label>
          <input type="number" class="form-control" name="nb_caract" id="nb_caract" />
        </div>
        <div id="transformation-replace-options" class="d-none">
          <div class="form-group">
            <label for="replace_search">Chercher</label>
            <input type="text" class="form-control" name="replace_search" id="replace_search" />
          </div>
          <div class="form-group">
            <label for="replace_value">Remplacer par</label>
            <input type="text" class="form-control" name="replace_value" id="replace_value" />
          </div>
        </div>
        <div id="transformation-decimal-options" class="d-none">
          <div class="form-group">
            <label for="decimal_separator">Séparateur décimal</label>
            <select class="form-control" id="decimal_separator"><option value=",">Virgule</option><option value=".">Point</option></select>
          </div>
          <div class="form-group">
            <label for="thousands_separator">Séparateur de milliers</label>
            <select class="form-control" id="thousands_separator"><option value="">Aucun</option><option value="." selected>Point</option><option value=",">Virgule</option><option value=" ">Espace</option></select>
          </div>
          <div class="form-group">
            <label for="decimal_places">Nombre de décimales</label>
            <input type="number" min="0" step="1" class="form-control" id="decimal_places" value="2">
          </div>
          <p class="text-muted">Avec 2 décimales : 281,5 → 28150. Aucun arrondi. Les deux séparateurs doivent être différents.</p>
        </div>
        <button type="button" id="btn-add-transformation" class="btn btn-outline-primary">Ajouter</button>
      </div>
    </div>
  </div>
</div>

<script>
  $("#btn-close-transformations").click(function(){
    $("#transformations-card").addClass('d-none');
  });

  function updateTransformationOptionFields() {
    let transformation = $("#transformation").val();
    $("#transformation-nb-caract-group").toggleClass('d-none', transformation === 'replace' || transformation === 'decimal_to_integer');
    $("#transformation-replace-options").toggleClass('d-none', transformation !== 'replace');
    $("#transformation-decimal-options").toggleClass('d-none', transformation !== 'decimal_to_integer');
    if (transformation === 'replace' || transformation === 'decimal_to_integer') {
      $("#nb_caract").val(0);
    }
  }

  $("#transformation").change(updateTransformationOptionFields);
  updateTransformationOptionFields();

  $("#btn-add-transformation").click(function(){
    let transformation = $("#transformation").val();
    let nbCaractere = $("#nb_caract").val();
    let data = {transformation: transformation, nb_caractere: nbCaractere};
    if (transformation === 'replace') {
      data.transformation_options = {search: $("#replace_search").val(), replace: $("#replace_value").val()};
    }
    if (transformation === 'decimal_to_integer') {
      data.transformation_options = {
        decimal_separator: $("#decimal_separator").val(),
        thousands_separator: $("#thousands_separator").val(),
        decimal_places: $("#decimal_places").val()
      };
    }
    $.ajax({
      url: "{{ path('check_format_mapping_add_transformations', {'idValue': mapping_value.id}) }}",
      type: 'POST',
      data: data,
      success: function(data){
        let newTr = '<tr>' +
            '<td>'+$("#transformation option:selected").text()+'</td>' +
            '<td></td>' +
            '<td>' +
            '<i class="fa fa-trash text-warning remove-transformation pointer" data-transformation-id="'+data.id+'"></i>' +
            '</td>' +
            '</tr>';
        let parameters = transformation === 'decimal_to_integer'
          ? 'Décimal : ' + data.options.decimal_separator + ' ; milliers : ' + (data.options.thousands_separator === '' ? 'aucun' : (data.options.thousands_separator === ' ' ? 'espace' : data.options.thousands_separator)) + ' ; décimales : ' + data.options.decimal_places
          : nbCaractere;
        let row = $(newTr);
        row.find('td').eq(1).text(parameters);
        $("#tbody-transformations").append(row);
        $("#addTransformationModal").modal('hide');
      },
      error: function(xhr){
        alert(xhr.responseJSON && xhr.responseJSON.error_message ? xhr.responseJSON.error_message : "Une erreur est survenue lors de l'ajout");
      }
    });
  });

  $(document).on('click', '.remove-transformation', function(){
    let thisElement = $(this);
    let transformationId = $(this).data('transformation-id');
    let data = {transformation_id: transformationId};
    $.ajax({
      url: "{{ path('check_format_mapping_remove_transformations') }}",
      type: 'POST',
      data: data,
      success: function(){
        thisElement.closest('tr').remove();
      },
      error: function(){
        alert("Une erreur est survenue lors de la suppression");
      }
    });
  });
</script>