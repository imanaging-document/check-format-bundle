<section class="check-format-control__result" aria-labelledby="check-format-result-title">
  <h3 id="check-format-result-title" class="check-format-control__section-title">Résultat du contrôle</h3>
  <p class="check-format-control__status check-format-control__status--error"><i class="fa fa-exclamation-triangle fa-fw" aria-hidden="true"></i>Le contrôle du fichier a révélé au moins une erreur.</p>
  {% if resultat.error_message is defined and resultat.error_message != '' %}
    <p class="text-danger">{{ resultat.error_message }}</p>
  {% endif %}
  {% if resultat.nb_lines is defined %}
    <p>Nombre de lignes dans le fichier : <strong>{{ resultat.nb_lines }}</strong></p>
  {% endif %}
  {% if resultat.errors_list is defined and resultat.errors_list is not empty %}
    <h4 class="check-format-control__details-title">Détails des erreurs</h4>
    <ul class="check-format-control__errors">
      {% for error_line in resultat.errors_list %}
        <li>Ligne {{ error_line.ligne }} :
          <ul>
            {% for error_detail in error_line.errors_list.classic %}
              <li>{% if error_detail.field is not null %}{{ error_detail.field }} : {% endif %}{{ error_detail.error_message }}</li>
            {% endfor %}
            {% for error_detail in error_line.errors_list.advanced %}
              <li>{% if error_detail.field is not null %}{{ error_detail.field }} : {% endif %}{{ error_detail.error_message }}</li>
            {% endfor %}
          </ul>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
