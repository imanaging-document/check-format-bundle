<section class="check-format-control__step">
  <h3 class="check-format-control__section-title">Intégration</h3>
  <p>La validation du fichier est terminée. Vous pouvez lancer son intégration.</p>
  <div id="btn_actions">
    <a href="{{ path(mapping_configuration_type.routeIntegrationFichier, {mappingTypeId: mapping_configuration_type.id}) }}" class="btn check-format-control__primary" id="btn_import_fichier"><i class="fa fa-check-circle fa-fw" aria-hidden="true"></i>Intégrer le fichier</a>
  </div>
  <div id="loader-actions" class="d-none check-format-control__progress" role="status">
    <i class="fa fa-spinner fa-spin fa-fw" aria-hidden="true"></i> Intégration en cours… Merci de patienter jusqu'à la fin des traitements.
  </div>
</section>

<script>
  $('#btn_import_fichier').click(function() {
    $('#loader-actions').removeClass('d-none');
    $('#btn_actions').addClass('d-none');
    $(this).prop('disabled', true);
  });
</script>